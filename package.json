  "license": "MIT",
  "author": "abdalkaderdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdalkaderdev/onerule.git"
  },
  "homepage": "https://github.com/Abdalkaderdev/onerule#readme",
  "bugs": "https://github.com/Abdalkaderdev/onerule/issues",
  "type": "module",
  "bin": {
    "onerule": "dist/bin.js"
  },
  "files": ["dist"],
  "engines": {
